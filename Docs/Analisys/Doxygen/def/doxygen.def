      define-mem-param  = {
        define-mem-def-name = 'delta';
      }; /*        define-mem-def--param */
      define-mem-param  = {
        define-mem-def-name = 'expected';
      }; /*        define-mem-def--param */
      define-mem-param  = {
        define-mem-def-name = 'actual';
      }; /*        define-mem-def--param */
      define-mem-param  = {
        define-mem-def-name = 'diff';
      }; /*        define-mem-def--param */
      define-mem-initializer = <<_EnD_oF_dEf_TeXt_
    if (UNITY_IS_INF(expected) && UNITY_IS_INF(actual) && (((expected) < 0) == ((actual) < 0))) return 1;   \
    if (UNITY_NAN_CHECK) return 1;                                                            \
    (diff) = (actual) - (expected);                                                           \
    if ((diff) < 0) (diff) = -(diff);                                                         \
    if ((delta) < 0) (delta) = -(delta);                                                      \
    return !(UNITY_IS_NAN(diff) || UNITY_IS_INF(diff) || ((diff) > (delta)))
_EnD_oF_dEf_TeXt_;
