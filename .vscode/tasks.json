{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "debug: show short paths",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "for %I in (.) do @echo WORKSPACE_SHORT=%~sI & if exist output\\main.exe (for %I in (output\\main.exe) do @echo EXE_SHORT=%~fsI) else (echo EXE_SHORT=(build first: Ctrl+Shift+B))"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "${config:project.makeCommand}",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "${config:project.makeCommand}",
      "args": [
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "run",
      "type": "shell",
      "command": "${config:project.makeCommand}",
      "args": [
        "run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "stop",
      "type": "shell",
      "command": "${config:project.makeCommand}",
      "args": [
        "stop"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
